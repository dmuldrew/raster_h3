+            .collect::<Vec<_>>();
+        let id = resolutions.len();
+        group.bench_with_input(
+            BenchmarkId::new("h3o/to_cell", id),
+            &resolutions,
+            |b, resolutions| {
+                b.iter(|| {
+                    let ll = black_box(ll);
+                    for &res in resolutions {
+                        black_box(ll.to_cell(res));
+                    }
+                });
+            },
+        );
+        group.bench_with_input(
+            BenchmarkId::new("h3o/to_cells", id),
+            &resolutions,
+            |b, resolutions| {
+                b.iter(|| {
+                    for cell in
+                        black_box(ll).to_cells(resolutions.iter().copied())
+                    {
+                        black_box(cell);
+                    }
+                });
+            },
+        );
+    }
+    group.finish();
