*.tiff
*.parquet
*.geoparquet
*.pmtiles
*.gpkg
sample_sf.tif

# Python & viewer caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & temporary files
*.log
*.tmp
*.temp